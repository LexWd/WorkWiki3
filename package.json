{
  "name": "quickreply-desk",
  "productName": "QuickReply Desk",
  "version": "1.0.0",
  "description": "Десктопная панель быстрых ответов, плейсхолдеров, таблиц и заметок для операторов поддержки",
  "author": "QuickReply Desk Team",
  "main": "electron/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist release",
    "lint": "tsc --noEmit",
    "electron:dev": "electron .",
    "electron:pack": "vite build && electron-builder --dir",
    "electron:build:win": "vite build && electron-builder --win portable nsis",
    "electron:build:portable": "vite build && electron-builder --win portable",
    "build:exe": "npm run electron:build:win"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.63.3"
  },
  "build": {
    "appId": "com.quickreply.desk",
    "productName": "QuickReply Desk",
    "copyright": "Copyright © 2026 QuickReply Desk",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/icon.png",
      "public/icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QuickReply Desk"
    },
    "portable": {
      "artifactName": "QuickReply-Desk-Portable-${version}.exe"
    }
  }
}
